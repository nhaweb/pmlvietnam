# Copy to .env.local (Next.js) and .dev.vars (Wrangler preview).
# Never commit real API keys.

RESEND_API_KEY=re_xxxxxxxx
# Resend sandbox can only deliver to the account email until a domain is verified.
CONTACT_TO_EMAIL=hoangviet1807@gmail.com
# After verifying nhaweb.vn on Resend:
# CONTACT_TO_EMAIL=hoangviet1807@gmail.com
# RESEND_FROM_EMAIL="PML Vietnam <noreply@nhaweb.vn>"

# Analytics (pmlvietnam.vn) — leave empty locally to skip loading tags
NEXT_PUBLIC_META_PIXEL_ID=
# GA4 G-… / Google Tag GT-… / Google Ads AW-…
NEXT_PUBLIC_GOOGLE_TAG_ID=

# Canonical site URL for sitemap / Open Graph (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# Sanity CMS (tin tức) — public values, Studio at /studio
NEXT_PUBLIC_SANITY_PROJECT_ID="7ocodxq0"
NEXT_PUBLIC_SANITY_DATASET="pml"
# Same values for the standalone Studio (`npx sanity deploy` → pml.sanity.studio)
SANITY_STUDIO_PROJECT_ID="7ocodxq0"
SANITY_STUDIO_DATASET="pml"
# Optional, defaults to 2026-10-13
# NEXT_PUBLIC_SANITY_API_VERSION=https://pmlvietnam.vn
