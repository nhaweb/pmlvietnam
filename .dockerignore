# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# VCS / local tooling — keep Fly/Depot context small (avoids upload timeouts)
.git
.github
.agents
.cursor
.vscode
docs
local
agent-transcripts
*.md
!README.md

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.open-next

# cloudflare
.wrangler
.dev.vars

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.open-next/*
.open-next*